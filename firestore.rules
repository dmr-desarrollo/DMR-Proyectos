rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Por defecto, denegar todo el acceso.
    match /{document=**} {
      allow read, write: if false;
    }

    // Permitir a los usuarios autenticados leer y escribir en las colecciones maestras.
    match /unidadesDeNegocio/{unidadId} {
      allow read, write: if request.auth != null;
    }
    match /vendedores/{vendedorId} {
      allow read, write: if request.auth != null;
    }
    match /motivosPerdida/{motivoId} {
      allow read, write: if request.auth != null;
    }
    match /subcategorias/{subcategoriaId} {
      allow read, write: if request.auth != null;
    }
    match /personasInvolucradas/{personaId} {
      allow read, write: if request.auth != null;
    }

    // Permitir a los usuarios autenticados leer y escribir en la colección de proyectos.
    match /proyectos/{projectId} {
      allow read, write: if request.auth != null;
    }
  }
}
